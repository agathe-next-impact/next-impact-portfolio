{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:docs && npm run check:sentinelle && next build",
    "check:docs": "node scripts/check-documentation-contract.mjs --strict",
    "check:sentinelle": "node scripts/check-sentinelle-isolation.mjs",
    "check:mail": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-sentinelle-mail.mjs",
    "test": "npm run typecheck:sentinelle && vitest run",
    "test:watch": "vitest",
    "typecheck:sentinelle": "tsc --noEmit -p tsconfig.sentinelle.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
