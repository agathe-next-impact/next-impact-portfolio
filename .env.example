# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — site vitrine + produit Sentinelle.
# Copier en .env.local et renseigner. Ne jamais commiter .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site vitrine (existant) ──────────────────────────────────────────────────
NODEMAILER_HOST=
NODEMAILER_PORT=465
NODEMAILER_USER=
NODEMAILER_PASS=
AUDIT_MAIL_TO=
GEMINI_API_KEY=
PAGESPEED_API_KEY=
WHATCMS_API_KEY=

# ── Sentinelle — base de données (phase 1) ───────────────────────────────────
# Chaîne de connexion Neon, pooled, avec sslmode=require.
DATABASE_URL=

# ── Sentinelle — tâches de fond (phase 1) ────────────────────────────────────
# En local : `npx inngest-cli@latest dev` suffit, ces deux clés restent vides.
# En production : à récupérer dans le tableau de bord Inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Sentinelle — scanner public (phase 2) ────────────────────────────────────
# Sel du hachage d'IP pour le rate limit. Chaîne aléatoire longue, propre à
# l'environnement. La changer invalide les compteurs en cours, sans autre effet.
SCAN_IP_SALT=

# ── Sentinelle — rédaction (phase 3) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modèle par défaut si non renseigné : claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
# Clé WPScan. Si absente, les collecteurs basculent sur Wordfence Intelligence.
WPSCAN_API_KEY=

# ── Sentinelle — envoi d'e-mails (phase 4) ───────────────────────────────────
RESEND_API_KEY=
# Adresse d'expédition sur le sous-domaine dédié (SPF/DKIM configurés).
RESEND_FROM="Sentinelle <veille@sentinelle.next-impact.digital>"
RESEND_REPLY_TO=agathe@next-impact.digital

# ── Sentinelle — admin (phase 4) ─────────────────────────────────────────────
# Préfixé SENTINELLE_ pour ne pas collider avec un éventuel admin vitrine.
SENTINELLE_ADMIN_PASSWORD=

# ── Sentinelle — paiement et espace client (phase 5) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SURVEILLANCE=
STRIPE_PRICE_CONSEIL=
# Secret de signature des liens magiques (espace client). Chaîne aléatoire.
MAGIC_LINK_SECRET=
