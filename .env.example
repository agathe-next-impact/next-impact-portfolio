# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement — site vitrine + produit Sentinelle.
# Copier en .env.local et renseigner. Ne jamais commiter .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site vitrine (existant) ──────────────────────────────────────────────────
# Envoi par SMTP Google (Gmail / Google Workspace) : smtp.gmail.com, port 465.
# NODEMAILER_PASS est un mot de passe d'application de 16 caractères, pas le mot
# de passe du compte — il exige la validation en deux étapes.
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_USER=
NODEMAILER_PASS=
AUDIT_MAIL_TO=
GEMINI_API_KEY=
PAGESPEED_API_KEY=
WHATCMS_API_KEY=

# ── Sentinelle — base de données (phase 1) ───────────────────────────────────
# Chaîne de connexion Neon, pooled, avec sslmode=require.
DATABASE_URL=

# ── Sentinelle — tâches de fond (phase 1) ────────────────────────────────────
# En développement, le SDK v4 ne devine plus le mode local : sans INNGEST_DEV=1
# il part en mode « cloud », refuse d'enregistrer l'application (PUT 500) et
# l'envoi d'événement échoue faute de clé. À laisser vide/absent en production.
INNGEST_DEV=1
# En local : `npx inngest-cli@latest dev -u http://localhost:3000/api/sentinelle/inngest`
# suffit, ces deux clés restent vides.
# En production : à récupérer dans le tableau de bord Inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Sentinelle — scanner public (phase 2) ────────────────────────────────────
# Sel du hachage d'IP pour le rate limit. Chaîne aléatoire longue, propre à
# l'environnement. La changer invalide les compteurs en cours, sans autre effet.
SCAN_IP_SALT=

# ── Sentinelle — rédaction (phase 3) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modèle par défaut si non renseigné : claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
# Clé WPScan — vulnérabilités du cœur, des extensions et des thèmes WordPress.
# Le repli Wordfence prévu par le pack n'existe plus (API v2 retirée le
# 2026-08-15, v3 authentifiée) : sans cette clé, un site WordPress reste couvert
# pour les fins de support et les retards de version, mais pas pour les failles.
WPSCAN_API_KEY=

# ── Sentinelle — envoi d'e-mails (SMTP Google) ───────────────────────────────
# Le pack prévoyait Resend ; les envois passent par le compte Google qui sert
# déjà au site. Variables distinctes des NODEMAILER_* ci-dessus, et aucun repli
# de l'une sur l'autre : la veille ne doit jamais partir sous l'identité du
# site parce qu'une variable manque. Voir src/sentinelle/emails/config.ts.
SENTINELLE_SMTP_HOST=smtp.gmail.com
# 465 = TLS implicite (défaut). 587 = STARTTLS.
SENTINELLE_SMTP_PORT=465
# Compte Google authentifié pour l'envoi.
SENTINELLE_SMTP_USER=
# Mot de passe d'application (16 caractères), pas le mot de passe du compte.
# Les espaces d'affichage sont retirés automatiquement.
SENTINELLE_SMTP_PASS=
# Adresse affichée. Google la réécrit si elle ne correspond pas au compte
# authentifié ou à une adresse « Envoyer en tant que » vérifiée : déclarer
# l'alias dans Gmail avant de la changer. Vide = le compte authentifié.
SENTINELLE_MAIL_FROM="Sentinelle <veille@next-impact.digital>"
SENTINELLE_MAIL_REPLY_TO=agathe@next-impact.digital

# ── Sentinelle — admin (phase 4) ─────────────────────────────────────────────
# File de validation sur /admin/sentinelle. Préfixé SENTINELLE_ pour ne pas
# collider avec un éventuel admin vitrine.
#
# 16 caractères minimum, sans quoi l'admin refuse de s'ouvrir : il n'existe pas
# de compteur d'essais fiable en serverless (une instance par lambda ne compte
# rien), donc la longueur du secret est la seule protection réelle. À générer au
# hasard : `node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"`
SENTINELLE_ADMIN_PASSWORD=

# ── Sentinelle — abonnement à la lettre d'info ───────────────────────────────
STRIPE_SECRET_KEY=
# Secret de signature du webhook (Stripe → /api/sentinelle/stripe/webhook).
# En local : `stripe listen --forward-to localhost:3000/api/sentinelle/stripe/webhook`
# affiche le secret whsec_… à coller ici.
STRIPE_WEBHOOK_SECRET=
# URL du Payment Link (page de paiement hébergée par Stripe), à créer dans le
# tableau de bord sur un prix récurrent de 19 €/mois. Tant qu'elle est vide, la
# page /sentinelle masque le bouton d'abonnement au lieu d'afficher un lien mort.
#
# Trois réglages à faire sur le Payment Link, sans quoi le parcours est incomplet :
#   1. un champ personnalisé OBLIGATOIRE de clé `site_url` (« Adresse de votre
#      site ») — sans lui, on encaisse un abonnement sans savoir quel site
#      surveiller ;
#   2. après paiement, « Rediriger les clients vers une page » avec l'URL
#      https://next-impact.digital/espace/bienvenue?session_id={CHECKOUT_SESSION_ID}
#      — c'est ce qui connecte l'abonné à son espace sans attendre un e-mail ;
#   3. le webhook (ci-dessus) écoutant `checkout.session.completed` et
#      `customer.subscription.deleted`.
STRIPE_PAYMENT_LINK_VEILLE=

# ── Sentinelle — espace client (phase 5) ─────────────────────────────────────
# Secret de signature des liens de connexion ET des sessions de l'espace client.
# 24 caractères minimum ; l'espace refuse de s'ouvrir en deçà. Le changer
# invalide d'un coup tous les liens en circulation et toutes les sessions
# ouvertes — c'est le geste de révocation d'urgence.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MAGIC_LINK_SECRET=
# Racine absolue du produit, pour les liens envoyés par e-mail (ils sont cliqués
# depuis une boîte, ils ne peuvent pas être relatifs). Vide en local : le repli
# est http://localhost:3000. Sur Vercel, l'URL de déploiement est utilisée à
# défaut ; renseigner cette variable en production pour éviter qu'un lien parte
# vers une URL de préversion.
SENTINELLE_BASE_URL=
# Plafond GLOBAL de lettres-échantillons par 24 h (borne de dépense API : la
# limite d'un scan/heure est par adresse IP, cent adresses la contournent).
# Vide : 20 par défaut.
SENTINELLE_LETTRES_PAR_JOUR=
